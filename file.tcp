# Open the input file for reading
set inFile [open "input.txt" r]
set content [read $inFile]
close $inFile

# Trim any unwanted whitespace (optional)
set content [string trim $content]

# Create or open the output file for writing
set outFile [open "output.txt" w]

# Write the content two times
puts $outFile $content
puts $outFile $content

# Close the file
close $outFile

puts "Content written twice into output.txt"



#!/usr/bin 
set fp [open "/home/dbit/Desktop/IT41/try.txt" r] 
set file_data [read $fp] 
close $fp 
set fpr [open "/home/dbit/Desktop/IT41/try2.txt" w] 
for {set i 2} {$i > 0} {incr i -1} { 
puts $fpr $file_data 
} 
close $fpr 